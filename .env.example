# ---- Database (Neon) ----
# Pooled connection string for the app, direct string for migrations.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/booking?sslmode=require"
DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/booking?sslmode=require"

# ---- API server ----
PORT=8787
API_BASE_URL="http://localhost:8787"
DASHBOARD_ORIGIN="http://localhost:5173"

# Machine credential for every /api/tenants/* route (except /widget/*).
# Generate one: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# The dashboard sends the same value as VITE_ENGINE_API_KEY.
ENGINE_API_KEY=""

# ---- Telegram (one bot per tenant in production) ----
# The env token is the legacy single-tenant path. Per-tenant tokens live in
# `tenant_channels`, sealed with CHANNEL_SECRET_KEY (see `pnpm tenant:channel`).
TELEGRAM_BOT_TOKEN=""
# Required when TELEGRAM_MODE=webhook. No default: the app refuses to start.
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_MODE="polling"
TELEGRAM_TENANT_SLUG="glow-salon"

# ---- Channel credentials ----
# Seals bot tokens at rest and derives per-tenant webhook secrets.
# Generate one: openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
# Rotating it changes every webhook URL — re-register them after.
CHANNEL_SECRET_KEY=""
# Where the API is publicly reachable; used to print webhook URLs.
PUBLIC_BASE_URL="http://localhost:8787"

# ---- LLM ----
GROQ_API_KEY=""
LLM_MODEL="openai/gpt-oss-120b"
